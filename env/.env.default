# Django
DJANGO_DEBUG =
DJANGO_ALLOWED_HOSTS = *

WEB_APP_PORT = 8000
WEB_APP_HOST = app

# SELDON image
SELDON_IMAGE = seldon-service:latest

# torch intra-op threads. Keep equal to the container's CPU limit; the dev
# compose service uses it as its `cpus:` limit and as OMP_NUM_THREADS.
SELDON_TORCH_THREADS = 1
