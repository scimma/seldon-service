# Django
DJANGO_DEBUG =
DJANGO_ALLOWED_HOSTS = *

WEB_APP_PORT = 8000
WEB_APP_HOST = app

# SELDON image
SELDON_IMAGE = seldon-service:latest

# torch intra-op threads. Keep equal to the container's CPU limit; the dev
# compose service uses it as its `cpus:` limit and as OMP_NUM_THREADS.
SELDON_TORCH_THREADS = 1

# Postgres. DATABASE_HOST is the compose `db` service; the same values
# initialize that service's database on first start. Local development only.
DATABASE_HOST = db
DATABASE_PORT = 5432
DATABASE_NAME = seldon
DATABASE_USER = seldon
DATABASE_PASSWORD = seldon-local-development-only

# Broker intake. Each broker reads SELDON_<BROKER>_* variables; an empty value
# means "use the default". Credentials (USERNAME, PASSWORD, GROUP_ID, and Fink's
# BOOTSTRAP_SERVERS) go in env/.env.dev, never here. Thresholds apply on restart.
# ROLE is qualifying or full_stream.
#
# Fink: SN selection topic. LSST livestream credentials are the bootstrap
# servers and the group id; no password.
SELDON_FINK_ENABLED = false
SELDON_FINK_ROLE = qualifying
SELDON_FINK_TOPICS = fink_most_likely_sn_lsst
SELDON_FINK_RELIABILITY_CUT = 0.6
SELDON_FINK_SN_LIKE_THRESHOLD = 0.5
SELDON_FINK_MAX_PARTITION_FETCH_BYTES = 131072
# SELDON_FINK_BOOTSTRAP_SERVERS, SELDON_FINK_GROUP_ID, SELDON_FINK_USERNAME: in env/.env.dev

# Lasair: the service's own filter. No credentials; any group id.
SELDON_LASAIR_ENABLED = false
SELDON_LASAIR_ROLE = qualifying
SELDON_LASAIR_BOOTSTRAP_SERVERS = lasair-lsst-kafka.lsst.ac.uk:9092
SELDON_LASAIR_GROUP_ID = seldon-service
SELDON_LASAIR_TOPICS = lasair_366c0efe0df
SELDON_LASAIR_RELIABILITY_CUT = 0.6
SELDON_LASAIR_SN_LIKE_THRESHOLD = 1.0

# Babamul: the full stream, every babamul.lsst.* topic (a ^ entry is a regex).
# SASL/SCRAM; the group id must start with "<username>-".
SELDON_BABAMUL_ENABLED = false
SELDON_BABAMUL_ROLE = full_stream
SELDON_BABAMUL_BOOTSTRAP_SERVERS = kaboom.caltech.edu:9093
SELDON_BABAMUL_SECURITY_PROTOCOL = SASL_PLAINTEXT
SELDON_BABAMUL_SASL_MECHANISM = SCRAM-SHA-512
SELDON_BABAMUL_TOPICS = ^babamul\.lsst\..*
# SELDON_BABAMUL_USERNAME, SELDON_BABAMUL_PASSWORD, SELDON_BABAMUL_GROUP_ID: in env/.env.dev
